{
  "name": "curriculum-vitae-rbs",
  "version": "1.0.0",
  "description": "CV generator for Roberto Stanziale",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstanziale/curriculum-vitae.git"
  },
  "keywords": [
    "Curriculum Vitae",
    "CV"
  ],
  "author": "Roberto B. Stanziale",
  "license": "MIT",
  "private": true,
  "scripts": {
    "compile": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build": "pnpm run build:prod",
    "build:dev": "node --env-file=.env src/index.ts",
    "build:prod": "node src/index.ts",
    "test": "node --test",
    "prepare": "husky"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "handlebars": "^4.7.9",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "typescript": "^7.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "**/*.{js,ts,json,html}": "pnpm run lint:fix"
  }
}
